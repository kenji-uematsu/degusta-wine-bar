---
import { getTranslations } from '../i18n/translations';

const t = getTranslations(Astro.currentLocale);
---
<section class="wine" id="wine" aria-labelledby="wine-title"><figure><img src="/images/degusta/wine.webp" srcset="/images/degusta/wine-800.webp 800w, /images/degusta/wine.webp 1600w" sizes="(min-width: 768px) 50vw, 100vw" width="1600" height="1200" alt={t.wine.imgAlt} loading="lazy" /></figure><div class="menu-item-copy"><p class="eyebrow">WINE</p><h3 id="wine-title">{t.wine.heading}</h3><p class="body-copy">{t.wine.text[0]}<br />{t.wine.text[1]}<br />{t.wine.text[2]}</p></div></section>
