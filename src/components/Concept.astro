---
import { getTranslations } from '../i18n/translations';

const t = getTranslations(Astro.currentLocale);
---
<section id="about" class="concept section">
  <div class="concept-intro"><p class="eyebrow">CONCEPT</p><h2>{t.concept.heading}</h2><div class="prose"><p>{t.concept.prose[0][0]}<br />{t.concept.prose[0][1]}</p><p>{t.concept.prose[1][0]}<br />{t.concept.prose[1][1]}</p><p>{t.concept.prose[2][0]}<br />{t.concept.prose[2][1]}</p></div></div>
  <div class="concept-experiences" aria-label={t.concept.experiencesAria}>
    <article class="concept-experience">
      <img src="/images/degusta/bar-wine-food.webp" width="1600" height="900" alt={t.concept.barImgAlt} loading="lazy" />
      <div><p class="eyebrow">BAR</p><h3>{t.concept.barHeading}</h3><p>{t.concept.barText[0]}<br />{t.concept.barText[1]}</p></div>
    </article>
    <article class="concept-experience">
      <img src="/images/degusta/store-shop.webp" width="900" height="506" alt={t.concept.shopImgAlt} loading="lazy" />
      <div><p class="eyebrow">WINE SHOP</p><h3>{t.concept.shopHeading}</h3><p>{t.concept.shopText[0]}<br />{t.concept.shopText[1]}</p></div>
    </article>
  </div>
</section>
