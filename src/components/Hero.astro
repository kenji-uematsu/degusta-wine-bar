---
import ReservationLink from './ReservationLink.astro';
import { getTranslations } from '../i18n/translations';

const t = getTranslations(Astro.currentLocale);
---
<section class="hero" aria-labelledby="hero-title">
  <div class="hero-copy"><div class="hero-heading"><h1 id="hero-title" class="hero-kicker">{t.hero.kicker[0]}<br />{t.hero.kicker[1]}</h1><img class="heading-rays" src="/illustrations/rays.svg" width="48" height="52" alt="" aria-hidden="true" /></div><p class="hero-lead">{t.hero.lead[0]}<br />{t.hero.lead[1]}<br />{t.hero.lead[2]}</p><div class="hero-actions"><ReservationLink /><span class="welcome-note-wrap"><svg class="welcome-arrow" viewBox="0 0 42 34" fill="none" aria-hidden="true"><path d="M38 28C25 30 11 23 9 7M3 13Q6 10 9 6L16 11" stroke="#a97834" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" /></svg><img class="welcome-art" src={t.hero.welcomeArtSrc} width="426" height="112" alt={t.hero.welcomeArtAlt} /></span></div></div>
  <figure class="hero-photo"><img src="/images/degusta/store-hero.webp" srcset="/images/degusta/store-hero-800.webp 800w, /images/degusta/store-hero.webp 1600w" sizes="(min-width: 1024px) 56vw, 100vw" width="1600" height="1200" alt={t.hero.photoAlt} fetchpriority="high" /><span class="photo-note"><img class="photo-note-art" src={t.hero.noteArtSrc} width="74" height="70" alt={t.hero.noteArtAlt} /><img class="badge-wine-icon" src="/illustrations/wine-glass.svg" width="42" height="62" alt="" aria-hidden="true" /></span></figure>
</section>
