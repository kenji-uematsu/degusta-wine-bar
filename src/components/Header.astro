<script>
  document.querySelectorAll('.mobile-menu a').forEach(link => link.addEventListener('click', () => document.querySelector('.mobile-menu')?.removeAttribute('open')));
  document.addEventListener('keydown', (event) => { if(event.key === 'Escape') { const menu = document.querySelector<HTMLDetailsElement>('.mobile-menu'); if(menu?.open) { menu.open = false; menu.querySelector<HTMLElement>('summary')?.focus(); } } });
</script>
