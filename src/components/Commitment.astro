---
import { getTranslations } from '../i18n/translations';

const t = getTranslations(Astro.currentLocale);
const icons = ['favorite-wine', 'counter-chat', 'wine-to-go'];
---
<section class="commitment section" id="our-style" aria-labelledby="style-title">
  <p class="eyebrow style-eyebrow">OUR STYLE</p>
  <h2 id="style-title">{t.commitment.heading}</h2>
  <p class="style-intro">{t.commitment.intro}</p>
  <div class="style-grid">
    {t.commitment.items.map((item, i) => (
      <article><img class="style-icon" src={`/illustrations/${icons[i]}.svg`} width="56" height="56" alt="" aria-hidden="true" /><h3>{item.heading[0]}<br />{item.heading[1]}</h3><p>{item.text[0]}<br />{item.text[1]}</p><span class="handwritten">{item.handwritten}</span></article>
    ))}
  </div>
</section>

