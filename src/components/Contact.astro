---
import { Phone, Mail } from '@lucide/astro';
import { site } from '../data/site';
import { getTranslations } from '../i18n/translations';

const t = getTranslations(Astro.currentLocale);
---
<section class="contact section" id="contact" aria-labelledby="contact-title" tabindex="-1">
  <p class="eyebrow">{t.contact.eyebrow}</p>
  <h2 id="contact-title">{t.contact.heading[0]}<br class="mobile-break" />{t.contact.heading[1]}</h2>
  <p class="body-copy"><span>{t.contact.sommelierText}</span><br />{t.contact.text[0]}<br />{t.contact.text[1]}</p>
  <figure class="contact-owner">
    <img class="contact-owner-photo" src="/images/degusta/sommelier-park.webp" width="900" height="1200" alt={t.contact.ownerPhotoAlt} loading="lazy" />
    <figcaption>{t.contact.ownerCaption}</figcaption>
  </figure>
  <div class="contact-actions">
    <a class="button" href={site.telephoneUrl} aria-label={`${t.contact.phoneAria} ${site.phone}`}>{site.phone}<Phone size={20} stroke-width={1.5} aria-hidden="true" /></a>
    <a class="button outline-button contact-email" href={site.mailtoUrl} aria-label={`${t.contact.emailAria} ${site.email}`}>{t.contact.emailLabel}<Mail size={18} stroke-width={1.5} aria-hidden="true" /></a>
  </div>
</section>

