---
import { Phone, ExternalLink } from '@lucide/astro';
import { site } from '../data/site';
---
<section class="contact section" id="contact" aria-labelledby="contact-title" tabindex="-1">
  <p class="eyebrow">LET’S MAKE IT A GOOD TIME.</p>
  <h2 id="contact-title">一杯の予定、<br class="mobile-break" />立てませんか。</h2>
  <p class="body-copy">ご予約も、貸切のご相談も。<br />ご質問は、お電話でどうぞ。</p>
  <div class="contact-actions">
    <a class="button" href={site.telephoneUrl} aria-label={`電話で予約・お問い合わせ ${site.phone}`}>{site.phone}<Phone size={20} stroke-width={1.5} aria-hidden="true" /></a>
    <a class="button outline-button contact-instagram" href={site.instagramUrl} target="_blank" rel="noopener noreferrer">Instagram<ExternalLink size={18} stroke-width={1.5} aria-hidden="true" /></a>
  </div>
</section>
