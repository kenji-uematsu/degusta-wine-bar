---
import { ArrowUp } from '@lucide/astro';
import { navigation } from '../data/navigation';
import { site } from '../data/site';
import ReservationLink from './ReservationLink.astro';
---
<footer class="footer"><div class="footer-main"><a class="logo" href="#top" aria-label="Degusta ホーム"><img class="brand-logo" src="/illustrations/degusta-logo-white.svg" width="210" height="100" alt="Degusta wine shop & bar" /></a><p>気軽に、ふらっとワインを。</p><a class="to-top" href="#top" aria-label="ページの先頭へ"><ArrowUp size={20} stroke-width={1.5} aria-hidden="true" /></a></div><nav aria-label="フッターナビゲーション">{navigation.map(item => <a href={item.href}>{item.label}</a>)}<ReservationLink class="nav-contact" showArrow={false} showPhone={false} /><a href={site.instagramUrl} target="_blank" rel="noopener noreferrer">Instagram</a></nav><div class="footer-bottom"><small>© 2026 Degusta</small></div></footer>
