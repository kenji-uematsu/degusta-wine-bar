---
import { ArrowUp } from '@lucide/astro';
import { navigation } from '../data/navigation';
import { site } from '../data/site';
import ReservationLink from './ReservationLink.astro';
import { getTranslations } from '../i18n/translations';

const t = getTranslations(Astro.currentLocale);
---
<footer class="footer"><div class="footer-main"><a class="logo" href="#top" aria-label={t.footer.homeAria}><img class="brand-logo" src="/illustrations/degusta-logo-white.svg" width="210" height="100" alt="Degusta wine shop & bar" /></a><p>{t.footer.tagline}</p><a class="to-top" href="#top" aria-label={t.footer.toTopAria}><ArrowUp size={20} stroke-width={1.5} aria-hidden="true" /></a></div><nav aria-label={t.footer.nav}>{navigation.map(item => <a href={item.href}>{t.nav[item.key]}</a>)}<ReservationLink class="nav-contact" showArrow={false} /><a href={site.instagramUrl} target="_blank" rel="noopener noreferrer">Instagram</a></nav><div class="footer-bottom"><small>© 2025-2026 Degusta</small></div></footer>
