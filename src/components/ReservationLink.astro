---
import { ArrowRight } from '@lucide/astro';
import { getTranslations } from '../i18n/translations';
interface Props { class?: string; showArrow?: boolean; }
const { class: className = 'button', showArrow = true } = Astro.props;
const t = getTranslations(Astro.currentLocale);
const label = t.reservation.label;
---
<span class="reservation-switch"><a class={className} href="#contact">{label}{showArrow && <ArrowRight size={18} stroke-width={1.5} aria-hidden="true" />}</a></span>
