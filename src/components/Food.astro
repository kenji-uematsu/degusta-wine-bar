---
import { getTranslations } from '../i18n/translations';

const t = getTranslations(Astro.currentLocale);
---
<section class="food" id="food" aria-labelledby="food-title"><figure><img src="/images/degusta/food.webp" srcset="/images/degusta/food-800.webp 800w, /images/degusta/food.webp 1600w" sizes="(min-width: 768px) 50vw, 100vw" width="1600" height="1200" alt={t.food.imgAlt} loading="lazy" /></figure><div class="menu-item-copy"><p class="eyebrow">FOOD</p><h3 id="food-title">{t.food.heading}</h3><p class="body-copy">{t.food.text[0]}<br />{t.food.text[1]}<br />{t.food.text[2]}</p></div></section>
