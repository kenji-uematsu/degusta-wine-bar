---
import { MapPin, TrainFront, Clock, CalendarDays, Phone, Mail, ExternalLink } from '@lucide/astro';
import { site } from '../data/site';
import { getTranslations } from '../i18n/translations';

const t = getTranslations(Astro.currentLocale);
---
<section class="access section" id="access" aria-labelledby="access-title"><div class="access-heading"><p class="eyebrow">ACCESS</p><h2 id="access-title">{t.access.heading}</h2></div><div class="access-grid"><div><figure class="access-photo"><img src="/images/degusta/store-exterior.webp" width="1600" height="900" alt={t.access.imgAlt} loading="lazy" /></figure></div><div class="access-info"><dl><div><dt><MapPin size={18} stroke-width={1.5} aria-hidden="true" />{t.access.addressLabel}</dt><dd>{t.access.addressValue || t.access.addressFallback}{site.mapUrl && <a class="underlined-link access-map-link" href={site.mapUrl} target="_blank" rel="noopener noreferrer">{t.access.mapLink} <ExternalLink size={18} stroke-width={1.5} aria-hidden="true" /></a>}</dd></div><div><dt><TrainFront size={18} stroke-width={1.5} aria-hidden="true" />{t.access.accessLabel}</dt><dd>{t.access.accessValue || t.access.accessFallback}</dd></div><div><dt><Phone size={18} stroke-width={1.5} aria-hidden="true" />{t.access.phoneLabel}</dt><dd>{site.phone ? <a class="tel-link" href={`tel:${site.phone.replace(/[^+\d]/g, '')}`}>{site.phone}</a> : t.access.phoneFallback}</dd></div><div><dt><Mail size={18} stroke-width={1.5} aria-hidden="true" />{t.access.emailLabel}</dt><dd>{site.email ? <a class="tel-link" href={site.mailtoUrl}>{site.email}</a> : t.access.emailFallback}</dd></div><div><dt><Clock size={18} stroke-width={1.5} aria-hidden="true" />{t.access.hoursLabel}</dt><dd>{t.access.hoursValue || t.access.hoursFallback}{t.access.lastEntryValue && <span class="last-entry">{t.access.lastEntryPrefix}{t.access.lastEntryValue}{t.access.lastEntrySuffix}</span>}</dd></div><div><dt><CalendarDays size={18} stroke-width={1.5} aria-hidden="true" />{t.access.closedLabel}</dt><dd>{t.access.closedDaysValue || t.access.closedFallback}</dd></div></dl><p class="fine-print access-hours-note">{t.access.notePrefix}<a href={site.instagramUrl} target="_blank" rel="noopener noreferrer">{t.access.noteLinkLabel}</a>{t.access.noteSuffix}</p></div></div></section>
