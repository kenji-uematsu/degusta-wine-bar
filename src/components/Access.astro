---
import { MapPin, TrainFront, Clock, CalendarDays, Phone, ExternalLink } from '@lucide/astro';
import { site } from '../data/site';
---
<section class="access section" id="access" aria-labelledby="access-title"><div class="access-heading"><p class="eyebrow">ACCESS</p><h2 id="access-title">アクセス</h2></div><div class="access-grid"><div><figure class="access-photo"><img src="/images/degusta/store-exterior.webp" width="1000" height="750" alt="緑の看板、丸窓、木の扉が目印のDegusta外観" loading="lazy" /></figure></div><div class="access-info"><dl><div><dt><MapPin size={18} stroke-width={1.5} aria-hidden="true" />住所</dt><dd>{site.address || '正式な住所は確認中です。'}</dd></div><div><dt><TrainFront size={18} stroke-width={1.5} aria-hidden="true" />アクセス</dt><dd>{site.access || '最寄り駅・道順は確認後に掲載します。'}</dd></div><div><dt><Clock size={18} stroke-width={1.5} aria-hidden="true" />営業時間</dt><dd>{site.hours || '正式な営業時間は確認中です。'}</dd></div><div><dt><CalendarDays size={18} stroke-width={1.5} aria-hidden="true" />定休日</dt><dd>{site.closedDays || '確認後に掲載します。'}</dd></div><div><dt><Phone size={18} stroke-width={1.5} aria-hidden="true" />電話番号</dt><dd>{site.phone ? <a class="tel-link" href={`tel:${site.phone.replace(/[^+\d]/g, '')}`}>{site.phone}</a> : '電話窓口は確認中です。'}</dd></div></dl>{site.mapUrl && <a class="underlined-link" href={site.mapUrl} target="_blank" rel="noopener noreferrer">Google Mapsで見る <ExternalLink size={18} stroke-width={1.5} aria-hidden="true" /></a>}<p class="fine-print">※営業日・営業時間は変更になる場合があります。最新情報は<a href={site.instagramUrl} target="_blank" rel="noopener noreferrer">Instagram</a>をご確認ください。</p></div></div></section>
