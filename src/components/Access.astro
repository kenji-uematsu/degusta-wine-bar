---
import { site } from '../data/site';
---
<section class="access section" id="access" aria-labelledby="access-title"><div class="section-top"><p class="eyebrow">COME SAY HELLO.</p><span class="section-no">06 / ACCESS</span></div><div class="access-grid"><div><h2 id="access-title">ふらっと、<br />お待ちしています。</h2><div class="access-sign"><span class="sign-name">Dégusta.</span><span>wine shop & bar</span><p>Good wine. Good time.</p></div></div><div class="access-info"><h3>Dégusta <span>wine shop & bar</span></h3><dl><div><dt>住所</dt><dd>{site.address || '正式な住所は確認中です。'}</dd></div><div><dt>アクセス</dt><dd>{site.access || '最寄り駅・道順は確認後に掲載します。'}</dd></div><div><dt>営業時間</dt><dd>{site.hours || '正式な営業時間は確認中です。'}</dd></div><div><dt>定休日</dt><dd>{site.closedDays || '確認後に掲載します。'}</dd></div><div><dt>電話番号</dt><dd>{site.phone ? <a href={`tel:${site.phone.replace(/[^+\d]/g, '')}`}>{site.phone}</a> : '電話窓口は確認中です。'}</dd></div></dl>{site.mapUrl && <a class="underlined-link" href={site.mapUrl} target="_blank" rel="noopener noreferrer">Google Mapsで見る <span aria-hidden="true">↗</span></a>}<p class="fine-print">臨時休業などの最新情報はInstagramでお知らせします。</p></div></div></section>
