---
import { getTranslations } from '../i18n/translations';

const t = getTranslations(Astro.currentLocale);
---
<section class="scenes section" id="space" aria-labelledby="scenes-title"><div class="scenes-heading"><p class="eyebrow">YOUR TIME</p><h2 id="scenes-title">{t.scenes.heading}</h2></div><div class="scene-list">{t.scenes.items.map(item => <article><div><h3>{item.heading}</h3><p>{item.text[0]}<br />{item.text[1]}</p></div></article>)}</div></section>
