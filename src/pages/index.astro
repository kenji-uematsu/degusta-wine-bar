---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Dégusta | wine shop & bar">
  <div class="page">
    <header class="header">
      <a class="brand" href="#top" aria-label="Dégusta ホーム">
        <strong>Dégusta</strong>
        <small>wine shop &amp; bar</small>
      </a>

      <button class="menu-toggle" type="button" aria-label="メニューを開く" aria-expanded="false">
        <span></span>
        <span></span>
        <span></span>
      </button>

      <nav class="nav" aria-label="メインナビゲーション">
        <a href="#concept">コンセプト</a>
        <a href="#menu">メニュー</a>
        <a href="#wine">ワイン一覧</a>
        <a href="#access">アクセス</a>
        <a class="reserve" href="mailto:reservation@degusta.example">ご予約・お問い合わせ</a>
      </nav>
    </header>

    <main id="top">
      <section class="hero">
        <div class="hero-copy">
          <p class="hero-logo">Dégusta</p>
          <p class="hero-tag">wine shop &amp; bar</p>
          <h1>ワインがつなぐ、<br />心ほどける時間。</h1>
          <p class="hero-lead">
            世界中から厳選したワインを、<br />
            落ち着いた空間でゆっくりとお楽しみください。<br />
            日常の中の特別なひとときを、Dégustaで。
          </p>
          <a class="outline-btn" href="mailto:reservation@degusta.example">ご予約はこちら <span class="arrow">→</span></a>
        </div>

        <div class="hero-photo" role="img" aria-label="ワインボトルとグラス、落ち着いたバーの雰囲気"></div>
      </section>

      <section class="concept" id="concept">
        <div>
          <p class="eyebrow">CONCEPT</p>
          <h2 class="title">コンセプト</h2>
          <p class="concept-text">
            Dégustaは、ワインをもっと身近に、もっと自由に<br />
            楽しんでいただくためのワインショップ＆バーです。<br />
            ソムリエが厳選したワインと、<br />
            そのワインに寄り添うお料理をご用意しております。<br />
            お一人様でも、大切な方とでも。<br />
            どうぞ心ゆくまでおくつろぎください。
          </p>
        </div>

        <div class="concept-card">
          <div class="concept-icon" aria-hidden="true"></div>
          <p>
            ショップではご自宅用やギフトに、<br />
            バーではグラスワインやお料理とともに<br />
            お楽しみいただけます。
          </p>
        </div>
      </section>

      <section class="features" id="wine">
        <h2 class="features-title">DÉGUSTAのこだわり</h2>
        <div class="feature-grid">
          <article class="feature">
            <div class="feature-icon grape" aria-hidden="true"></div>
            <div>
              <h3>厳選されたワイン</h3>
              <p>ソムリエが世界各地から厳選したワインを常時100種類以上ご用意しています。</p>
            </div>
          </article>

          <article class="feature">
            <div class="feature-icon dish" aria-hidden="true"></div>
            <div>
              <h3>ワインに寄り添う料理</h3>
              <p>素材の味を大切にしたお料理をワインとともにお楽しみいただけます。</p>
            </div>
          </article>

          <article class="feature">
            <div class="feature-icon chair" aria-hidden="true"></div>
            <div>
              <h3>落ち着いた大人の空間</h3>
              <p>木のぬくもりを感じる落ち着いた空間で、ゆったりとした時間を。</p>
            </div>
          </article>
        </div>
      </section>

      <section class="menu-section" id="menu">
        <div class="menu-copy">
          <p class="eyebrow">MENU</p>
          <h2 class="title">メニューの一例</h2>

          <div class="menu-items">
            <article class="menu-item">
              <div class="menu-icon bottle" aria-hidden="true"></div>
              <div>
                <h3>グラスワイン</h3>
                <p>赤・白・スパークリングなど<br />常時10種類以上</p>
                <p class="price">¥800〜</p>
              </div>
            </article>

            <article class="menu-item">
              <div class="menu-icon plate" aria-hidden="true"></div>
              <div>
                <h3>フードメニュー</h3>
                <p>前菜・チーズ・パスタなど<br />ワインに合うお料理をご用意</p>
                <p class="price">¥600〜</p>
              </div>
            </article>
          </div>

          <a class="outline-btn" href="#">メニュー一覧を見る <span class="arrow">→</span></a>
        </div>

        <div class="menu-photo" aria-label="ワインとおつまみのイメージ"></div>
      </section>

      <section class="access" id="access">
        <div>
          <p class="eyebrow">ACCESS</p>
          <h2 class="title">アクセス</h2>
          <p class="address">
            神奈川県川崎市中原区新丸子東1-837-9<br />
            新丸子駅 東口より徒歩3分
          </p>
          <a class="map-btn" href="#">Google Mapで見る <span class="arrow">→</span></a>
        </div>

        <div class="map" aria-label="地図のイメージ"></div>
      </section>
    </main>

    <footer class="footer">
      <a class="brand" href="#top" aria-label="Dégusta ホーム">
        <strong>Dégusta</strong>
        <small>wine shop &amp; bar</small>
      </a>

      <nav class="foot-nav" aria-label="フッターナビゲーション">
        <a href="#concept">コンセプト</a>
        <a href="#menu">メニュー</a>
        <a href="#wine">ワイン一覧</a>
        <a href="#access">アクセス</a>
      </nav>

      <div class="social">
        <a href="https://www.instagram.com/" target="_blank" rel="noopener" aria-label="Instagram">◎</a>
        <a href="https://x.com/" target="_blank" rel="noopener" aria-label="X">𝕏</a>
        <span>© Dégusta wine shop &amp; bar</span>
      </div>
    </footer>
  </div>

  <script>
    const button = document.querySelector('.menu-toggle');
    const nav = document.querySelector('.nav');

    if (button && nav) {
      button.addEventListener('click', () => {
        const open = nav.classList.toggle('open');
        button.classList.toggle('open', open);
        button.setAttribute('aria-expanded', String(open));
        button.setAttribute('aria-label', open ? 'メニューを閉じる' : 'メニューを開く');
      });

      nav.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => {
          nav.classList.remove('open');
          button.classList.remove('open');
          button.setAttribute('aria-expanded', 'false');
        });
      });
    }
  </script>

  <style>
    :root {
      --paper: #f7f3eb;
      --ink: #191914;
      --green: #002b20;
      --deep: #00261c;
      --gold: #a97934;
      --hair: #ba9a6c;
    }

    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      background: var(--paper);
      color: var(--ink);
      font-family: "Yu Mincho", "Hiragino Mincho ProN", "Noto Serif JP", serif;
      letter-spacing: 0.025em;
      font-feature-settings: "palt";
    }
    a { color: inherit; text-decoration: none; }
    button { font: inherit; }
    p, h1, h2, h3 { margin-top: 0; }

    .page {
      width: 100%;
      overflow: hidden;
      background: var(--paper);
    }

    .page:after {
      content: "";
      position: fixed;
      inset: 0;
      z-index: 30;
      pointer-events: none;
      opacity: 0.13;
      mix-blend-mode: multiply;
      background: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.72' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.25'/%3E%3C/svg%3E");
    }

    .header {
      height: 10.42vw;
      padding: 0 4.4vw;
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: linear-gradient(90deg, var(--green), var(--deep));
      color: #fff;
      position: relative;
      z-index: 10;
    }

    .brand {
      display: flex;
      flex-direction: column;
      line-height: 1;
      letter-spacing: 0.075em;
    }

    .brand strong {
      font-size: 3.5vw;
      font-weight: 400;
      font-family: "Georgia", "Times New Roman", serif;
    }

    .brand small {
      margin-top: 0.7vw;
      font-size: 1.02vw;
      letter-spacing: 0.07em;
      text-transform: lowercase;
    }

    .nav {
      display: flex;
      align-items: center;
      gap: 4.45vw;
      font-size: 1.22vw;
      letter-spacing: 0.08em;
    }

    .nav a {
      position: relative;
      transition: opacity 0.2s;
    }

    .nav a:hover { opacity: 0.7; }

    .nav a:not(.reserve):after {
      content: "";
      position: absolute;
      right: 100%;
      bottom: -0.75vw;
      left: 0;
      height: 1px;
      background: #b1884a;
      transition: right 0.2s;
    }

    .nav a:hover:after { right: 0; }

    .nav .reserve {
      padding: 1.72vw 2.12vw;
      background: #9b7032;
    }

    .menu-toggle { display: none; }

    .hero {
      position: relative;
      height: 53.7vw;
      display: grid;
      grid-template-columns: 49.2% 50.8%;
      background: #f4efe7;
      overflow: hidden;
    }

    .hero::before {
      content: "";
      position: absolute;
      inset: 0;
      z-index: 0;
      background: linear-gradient(
        90deg,
        rgba(247, 243, 235, 0.98) 0%,
        rgba(247, 243, 235, 0.92) 30%,
        rgba(247, 243, 235, 0.48) 52%,
        rgba(22, 21, 18, 0.16) 78%,
        rgba(22, 21, 18, 0.32) 100%
      );
      pointer-events: none;
    }

    .hero-copy {
      position: relative;
      z-index: 2;
      padding: 6.4vw 0 4vw 7.35vw;
      background: transparent;
    }

    .hero-copy::after {
      content: "";
      position: absolute;
      top: 0;
      right: -5vw;
      width: 10vw;
      height: 100%;
      background: linear-gradient(
        90deg,
        rgba(247, 243, 235, 1) 0%,
        rgba(247, 243, 235, 0.8) 26%,
        rgba(247, 243, 235, 0.2) 62%,
        rgba(247, 243, 235, 0) 100%
      );
      pointer-events: none;
    }

    .hero-logo {
      margin: 0;
      font-size: 8.18vw;
      line-height: 0.89;
      letter-spacing: 0.055em;
      font-weight: 400;
      font-family: "Georgia", "Times New Roman", serif;
    }

    .hero-tag {
      margin: 0.9vw 0 2.85vw 0.35vw;
      font-size: 2.72vw;
      letter-spacing: 0.08em;
      text-transform: lowercase;
    }

    .hero h1 {
      margin: 0 0 2.35vw 0.35vw;
      color: var(--gold);
      font-size: 2.73vw;
      line-height: 1.82;
      letter-spacing: 0.095em;
      font-weight: 400;
    }

    .hero-lead {
      margin: 0 0 2.7vw 0.35vw;
      font-size: 1.31vw;
      line-height: 1.94;
    }

    .hero-photo {
      position: relative;
      z-index: 1;
      overflow: hidden;
      background-image:
        linear-gradient(
          90deg,
          rgba(247, 243, 235, 0.06) 0%,
          rgba(247, 243, 235, 0.12) 26%,
          rgba(247, 243, 235, 0.2) 42%,
          rgba(18, 16, 14, 0.12) 72%,
          rgba(18, 16, 14, 0.32) 100%
        ),
        url('/hero-wine-scene.png');
      background-repeat: no-repeat;
      background-size: cover;
      background-position: center center;
      background-color: rgba(25, 25, 20, 0.22);
      filter: saturate(0.9) contrast(1.08) brightness(0.96);
      transform: scale(1.04);
    }

    .hero-photo::after {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(
        90deg,
        rgba(244, 239, 231, 0.82) 0%,
        rgba(244, 239, 231, 0.46) 24%,
        rgba(244, 239, 231, 0.1) 52%,
        rgba(244, 239, 231, 0) 100%
      );
      pointer-events: none;
    }

    .outline-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 2.35vw;
      min-width: 18.5vw;
      padding: 1.28vw 2.2vw;
      border: 1px solid var(--hair);
      font-size: 1.24vw;
      letter-spacing: 0.06em;
      transition: 0.2s;
    }

    .outline-btn:hover,
    .outline-btn:focus-visible {
      background: var(--green);
      border-color: var(--green);
      color: #fff;
    }

    .arrow { font-size: 1.35em; }

    .eyebrow {
      margin: 0 0 1.28vw;
      color: var(--gold);
      font-size: 1.22vw;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }

    .title {
      margin: 0;
      font-size: 2.22vw;
      font-weight: 500;
      letter-spacing: 0.12em;
    }

    .title:after {
      content: "";
      display: block;
      width: 3.55vw;
      height: 1px;
      margin-top: 1.42vw;
      background: var(--gold);
    }

    .concept {
      height: 43.65vw;
      padding: 5.75vw 7.35vw;
      display: grid;
      grid-template-columns: 1.04fr 0.96fr;
      gap: 8.1vw;
      align-items: start;
    }

    .concept-text {
      margin: 2.4vw 0 0;
      font-size: 1.25vw;
      line-height: 2.23;
    }

    .concept-card {
      height: 20.1vw;
      margin-top: 4.25vw;
      padding: 4.1vw 2vw;
      text-align: center;
      color: #fff;
      background: radial-gradient(circle, #073b2d, var(--green) 75%);
      border: 1px solid rgba(191, 155, 110, 0.45);
    }

    .concept-icon {
      width: 4.9vw;
      height: 4.8vw;
      margin: 0 auto;
      background-position: -68.7vw -77.5vw;
      background-image: url('/degusta-reference.png');
      background-repeat: no-repeat;
      background-size: 100vw auto;
    }

    .concept-card p {
      margin: 1.3vw 0 0;
      font-size: 1.2vw;
      line-height: 2.05;
    }

    .features {
      height: 28.75vw;
      padding: 3.85vw 10.35vw 3vw;
      color: #fff;
      background: radial-gradient(circle at 50% 0, #07382c, var(--green) 74%);
    }

    .features-title {
      margin: 0;
      text-align: center;
      color: var(--gold);
      font-size: 1.82vw;
      font-weight: 400;
      letter-spacing: 0.08em;
    }

    .features-title:after {
      content: "";
      display: block;
      width: 4.2vw;
      height: 1px;
      margin: 1.3vw auto 2.85vw;
      background: #9e783c;
    }

    .feature-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
    }

    .feature {
      min-height: 10.8vw;
      padding: 0 3.15vw;
      display: grid;
      grid-template-columns: 4.6vw 1fr;
      gap: 1.35vw;
      border-right: 1px solid #9b743866;
    }

    .feature:first-child { padding-left: 0; }
    .feature:last-child {
      padding-right: 0;
      border: 0;
    }

    .feature-icon {
      width: 4.6vw;
      height: 6vw;
      background-image: url('/degusta-reference.png');
      background-repeat: no-repeat;
      background-size: 100vw auto;
    }

    .grape { background-position: -10.8vw -118.7vw; }
    .dish { background-position: -37.3vw -118.7vw; }
    .chair { background-position: -66.7vw -118.7vw; }

    .feature h3 {
      margin: 0.35vw 0 1.05vw;
      font-size: 1.34vw;
      font-weight: 500;
      letter-spacing: 0.06em;
    }

    .feature p {
      margin: 0;
      font-size: 1.07vw;
      line-height: 1.84;
    }

    .menu-section {
      height: 38.05vw;
      display: grid;
      grid-template-columns: 63.55% 36.45%;
    }

    .menu-copy {
      padding: 5.15vw 4.6vw 3vw 7.35vw;
    }

    .menu-items {
      margin: 2.65vw 0 2.75vw;
      display: grid;
      grid-template-columns: 1fr 1fr;
    }

    .menu-item {
      padding-right: 2.75vw;
      display: grid;
      grid-template-columns: 4.7vw 1fr;
      gap: 1.55vw;
    }

    .menu-item + .menu-item {
      padding: 0 0 0 2.75vw;
      border-left: 1px solid #b99b6e66;
    }

    .menu-icon {
      width: 4.4vw;
      height: 7.1vw;
      background-image: url('/degusta-reference.png');
      background-repeat: no-repeat;
      background-size: 100vw auto;
    }

    .bottle { background-position: -8.2vw -150.9vw; }
    .plate { width: 6.2vw; background-position: -34.7vw -150.9vw; }

    .menu-item h3 {
      margin: 0.25vw 0 1vw;
      font-size: 1.26vw;
      letter-spacing: 0.06em;
    }

    .menu-item p {
      margin: 0;
      font-size: 1.05vw;
      line-height: 1.68;
    }

    .menu-item .price {
      margin-top: 0.72vw;
      font-size: 1.55vw;
    }

    .menu-copy .outline-btn {
      display: flex;
      margin: auto;
    }

    .menu-photo {
      background-image: linear-gradient(90deg, rgba(40, 23, 13, 0.1), rgba(40, 23, 13, 0.25)), url('/degusta-reference.png');
      background-repeat: no-repeat;
      background-size: 100vw auto;
      background-position: right top -136.35vw;
      background-color: #28170d;
    }

    .access {
      height: 27.45vw;
      padding: 4.35vw 7.35vw;
      display: grid;
      grid-template-columns: 1.03fr 0.97fr;
      gap: 4vw;
    }

    .address {
      margin: 1.52vw 0 1.65vw;
      font-size: 1.11vw;
      line-height: 2.1;
    }

    .map-btn {
      display: inline-flex;
      align-items: center;
      gap: 2.3vw;
      padding: 1.18vw 2.15vw;
      background: var(--green);
      color: #fff;
      font-size: 1.14vw;
      transition: 0.2s;
    }

    .map-btn:hover { background: #9b7032; }

    .map {
      height: 20vw;
      margin-top: -0.4vw;
      background-image: url('/degusta-reference.png');
      background-repeat: no-repeat;
      background-size: 100vw auto;
      background-position: right top -175.1vw;
      background-color: rgba(255,255,255,0.2);
      border: 1px solid rgba(25, 25, 20, 0.12);
    }

    .footer {
      height: 9.08vw;
      padding: 0 4.4vw;
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      background: var(--green);
      color: #fff;
    }

    .footer .brand strong {
      font-size: 2.85vw;
    }

    .footer .brand small {
      font-size: 0.88vw;
    }

    .foot-nav {
      display: flex;
      gap: 3.35vw;
      font-size: 1.03vw;
    }

    .social {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 1.8vw;
      font-size: 1.02vw;
      white-space: nowrap;
    }

    .social a {
      display: grid;
      width: 2vw;
      height: 2vw;
      place-items: center;
      border: 1px solid #fff;
      border-radius: 50%;
      font-family: Arial, sans-serif;
      font-size: 1.15vw;
    }

    @media (max-width: 700px) {
      .header {
        height: 12.34vw;
        padding: 0 5.2vw;
      }

      .brand strong { font-size: 5.3vw; }
      .brand small {
        margin-top: 1.2vw;
        font-size: 2.2vw;
      }

      .menu-toggle {
        display: flex;
        width: 9vw;
        height: 7vw;
        padding: 0;
        flex-direction: column;
        justify-content: space-between;
        border: 0;
        background: transparent;
        cursor: pointer;
      }

      .menu-toggle span {
        display: block;
        width: 100%;
        height: 0.42vw;
        background: #fff;
        transition: 0.2s;
      }

      .menu-toggle.open span:nth-child(1) { transform: translateY(3.28vw) rotate(45deg); }
      .menu-toggle.open span:nth-child(2) { opacity: 0; }
      .menu-toggle.open span:nth-child(3) { transform: translateY(-3.28vw) rotate(-45deg); }

      .nav {
        display: none;
        position: absolute;
        z-index: 25;
        top: 12.34vw;
        left: 0;
        right: 0;
        padding: 3vw 5vw;
        flex-direction: column;
        gap: 0;
        background: var(--green);
        font-size: 3.4vw;
      }

      .nav.open { display: flex; }
      .nav a {
        width: 100%;
        padding: 3vw;
        border-bottom: 1px solid #ffffff33;
      }
      .nav .reserve { margin-top: 2vw; text-align: center; }

      .hero {
        position: relative;
        height: 57.14vw;
        display: block;
        color: #fff;
        background-image:
          linear-gradient(180deg, rgba(25, 25, 20, 0.32), rgba(25, 25, 20, 0.22)),
          url('/hero-wine-scene-mobile.png');
        background-repeat: no-repeat;
        background-size: cover;
        background-position: center;
      }

      .hero::before {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(
          90deg,
          rgba(19, 16, 14, 0.38) 0%,
          rgba(19, 16, 14, 0.2) 30%,
          rgba(19, 16, 14, 0.08) 60%,
          rgba(19, 16, 14, 0) 100%
        );
        pointer-events: none;
      }

      .hero-copy {
        position: relative;
