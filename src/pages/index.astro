---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Wine Bar Mockup | 初期モック">
  <main class="mx-auto max-w-6xl px-4 pb-16 pt-8 sm:px-6 lg:px-8">
    <header class="sticky top-0 z-20 mb-6 border-b border-[rgba(20,62,52,0.1)] bg-[rgba(247,244,241,0.82)] backdrop-blur-sm">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-4 sm:px-6 lg:px-8">
        <div>
          <p class="text-[10px] font-medium uppercase tracking-[0.38em] text-stone-500">mock</p>
          <h1 class="mt-1 text-lg font-medium tracking-[0.18em] text-[#143e34]">Wine Bar Name</h1>
        </div>

        <nav class="hidden items-center gap-8 text-[11px] uppercase tracking-[0.24em] text-stone-600 md:flex">
          <a href="#concept" class="transition hover:text-[#143e34]">Concept</a>
          <a href="#wines" class="transition hover:text-[#143e34]">Wines</a>
          <a href="#story" class="transition hover:text-[#143e34]">Story</a>
          <a href="#visit" class="transition hover:text-[#143e34]">Visit</a>
        </nav>

        <a
          href="#reserve"
          class="rounded-full border border-[#143e34] px-4 py-2 text-[10px] font-medium uppercase tracking-[0.2em] text-[#143e34] transition hover:bg-[#143e34] hover:text-[#f8f6f3]"
        >
          Reserve
        </a>
      </div>
    </header>

    <section class="relative overflow-hidden rounded-[2rem] border border-[rgba(20,62,52,0.12)] bg-[#f5f1eb] shadow-[0_20px_70px_rgba(20,62,52,0.08)]">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,_rgba(20,62,52,0.12),_transparent_36%),linear-gradient(135deg,rgba(255,255,255,0.2),rgba(20,62,52,0.02))]"></div>
      <div class="relative grid items-center gap-8 px-6 py-10 sm:px-8 md:grid-cols-[1.15fr_0.85fr] md:px-10 md:py-14">
        <div class="max-w-xl">
          <p class="text-[10px] font-medium uppercase tracking-[0.45em] text-stone-500">Initial mock</p>
          <h2 class="mt-5 text-4xl leading-[0.96] text-[#143e34] sm:text-5xl md:text-6xl">
            ワインと、<br />静かな時間を。
          </h2>
          <p class="mt-5 max-w-lg text-base leading-7 text-stone-600 md:text-lg">
            地元の良い酒と、心地よいひとときをつくるワインバーの方向性を示す仮構成です。<br />
            ここでは情報確認のための見せ方を優先し、後で本番サイトに発展しやすい形にしています。
          </p>

          <div class="mt-8 flex flex-wrap gap-3">
            <a
              href="#wines"
              class="rounded-full bg-[#143e34] px-6 py-3 text-[10px] font-medium uppercase tracking-[0.18em] text-[#f8f6f3] transition hover:bg-[#0d2d28]"
            >
              Explore wines
            </a>
            <a
              href="#visit"
              class="rounded-full border border-[#143e34]/30 bg-white/60 px-6 py-3 text-[10px] font-medium uppercase tracking-[0.18em] text-[#143e34] transition hover:border-[#143e34] hover:bg-white"
            >
              Visit us
            </a>
          </div>
        </div>

        <div class="relative">
          <div class="rounded-[1.75rem] border border-[rgba(31,27,24,0.13)] bg-[#d6cabd]/80 p-4 shadow-[0_24px_45px_rgba(59,49,41,0.12)]">
            <div class="aspect-[4/5] overflow-hidden rounded-[1.3rem] bg-[linear-gradient(135deg,#c4b6a3_0%,#e6dfd7_28%,#b99d7e_100%)] p-5">
              <div class="flex h-full flex-col justify-between">
                <div class="flex items-start justify-between">
                  <div class="h-14 w-14 rounded-full border border-white/50 bg-white/18 backdrop-blur-sm"></div>
                  <div class="h-8 w-20 rounded-full border border-[rgba(60,52,47,0.3)] bg-[rgba(255,255,255,0.12)]"></div>
                </div>

                <div class="flex items-end justify-between gap-4">
                  <div class="space-y-3">
                    <div class="h-12 w-20 rounded-t-[1.2rem] rounded-b-md border border-[rgba(60,52,47,0.35)] bg-[rgba(255,255,255,0.18)]"></div>
                    <div class="h-28 w-28 rounded-full border border-[rgba(60,52,47,0.35)] bg-[rgba(255,255,255,0.12)]"></div>
                  </div>

                  <div class="w-24 rounded-[1.2rem] border border-[rgba(60,52,47,0.35)] bg-[rgba(255,255,255,0.18)] p-3 backdrop-blur-sm">
                    <div class="mb-2 h-2 w-10 rounded bg-stone-500/70"></div>
                    <div class="mb-2 h-2 w-14 rounded bg-stone-400/80"></div>
                    <div class="h-2 w-8 rounded bg-stone-400/80"></div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="concept" class="mt-16 grid gap-5 md:grid-cols-3">
      <article class="rounded-[1.5rem] border border-[rgba(20,62,52,0.12)] bg-white/60 p-6 shadow-[0_18px_40px_rgba(20,62,52,0.04)]">
        <p class="text-[10px] font-medium uppercase tracking-[0.28em] text-stone-500">Concept</p>
        <h3 class="mt-4 text-2xl text-[#143e34]">落ち着いた空間</h3>
        <p class="mt-3 text-sm leading-6 text-stone-600">
          ひと息つける店内と、ワインを丁寧に楽しめる雰囲気を軸にした提案です。
        </p>
      </article>

      <article class="rounded-[1.5rem] border border-[rgba(20,62,52,0.12)] bg-white/60 p-6 shadow-[0_18px_40px_rgba(20,62,52,0.04)]">
        <p class="text-[10px] font-medium uppercase tracking-[0.28em] text-stone-500">Selection</p>
        <h3 class="mt-4 text-2xl text-[#143e34]">こだわりの一本</h3>
        <p class="mt-3 text-sm leading-6 text-stone-600">
          季節や店主の好みに合わせた、選び抜かれたワインの紹介を想定しています。
        </p>
      </article>

      <article class="rounded-[1.5rem] border border-[rgba(20,62,52,0.12)] bg-white/60 p-6 shadow-[0_18px_40px_rgba(20,62,52,0.04)]">
        <p class="text-[10px] font-medium uppercase tracking-[0.28em] text-stone-500">Story</p>
        <h3 class="mt-4 text-2xl text-[#143e34]">人と酒の時間</h3>
        <p class="mt-3 text-sm leading-6 text-stone-600">
          お客様との距離感や、店主の想いを伝えるストーリーの配置を予定しています。
        </p>
      </article>
    </section>

    <section id="wines" class="mt-20">
      <div class="mb-6 flex items-end justify-between gap-4">
        <div>
          <p class="text-[10px] font-medium uppercase tracking-[0.36em] text-stone-500">Wines</p>
          <h3 class="mt-3 text-3xl text-stone-900 md:text-4xl">Featured bottles</h3>
        </div>
        <p class="text-sm text-stone-500">仮情報 / 事実確認前</p>
      </div>

      <div class="grid gap-6 md:grid-cols-3">
        <article class="overflow-hidden rounded-[1.5rem] border border-[rgba(31,27,24,0.12)] bg-white/60">
          <div class="h-52 bg-[linear-gradient(160deg,#d9d0c5_0%,#b8a38d_45%,#7e6856_100%)]"></div>
          <div class="p-5">
            <p class="text-[10px] uppercase tracking-[0.2em] text-stone-500">AOC / 仮</p>
            <h4 class="mt-3 text-2xl text-stone-900">Bottle 01</h4>
            <p class="mt-3 text-sm leading-6 text-stone-600">
              果実感のある軽めの一本。食前のひと口に合う、やわらかな印象です。
            </p>
          </div>
        </article>

        <article class="overflow-hidden rounded-[1.5rem] border border-[rgba(31,27,24,0.12)] bg-white/60">
          <div class="h-52 bg-[linear-gradient(160deg,#c4b8ac_0%,#8c7d73_40%,#52453f_100%)]"></div>
          <div class="p-5">
            <p class="text-[10px] uppercase tracking-[0.2em] text-stone-500">Estate / 仮</p>
            <h4 class="mt-3 text-2xl text-stone-900">Bottle 02</h4>
            <p class="mt-3 text-sm leading-6 text-stone-600">
              余韻の深い一本。落ち着いた夜に向く、静かな香りを持っています。
            </p>
          </div>
        </article>

        <article class="overflow-hidden rounded-[1.5rem] border border-[rgba(31,27,24,0.12)] bg-white/60">
          <div class="h-52 bg-[linear-gradient(160deg,#e5d4b4_0%,#bea17f_45%,#7a5f49_100%)]"></div>
          <div class="p-5">
            <p class="text-[10px] uppercase tracking-[0.2em] text-stone-500">Rare / 仮</p>
            <h4 class="mt-3 text-2xl text-stone-900">Bottle 03</h4>
            <p class="mt-3 text-sm leading-6 text-stone-600">
              特別な日を彩る一本。店主のこだわりが伝わる、特集向けの提案です。
            </p>
          </div>
        </article>
      </div>
    </section>

    <section id="story" class="mt-20 rounded-[2rem] border border-[rgba(20,62,52,0.12)] bg-[#f2efe9] p-6 md:p-10">
      <div class="grid gap-8 md:grid-cols-[1.2fr_0.8fr]">
        <div>
          <p class="text-[10px] font-medium uppercase tracking-[0.36em] text-stone-500">Story</p>
          <h3 class="mt-3 text-3xl text-[#143e34] md:text-4xl">ワインで人と人をつなぐ</h3>
          <p class="mt-4 max-w-xl text-base leading-8 text-stone-600">
            このセクションでは、店主の想いやワインへのこだわり、お客様に届けたい体験を簡潔に紹介する構成を予定しています。具体的な文章はヒアリング後に差し替えます。
          </p>
        </div>

        <div class="rounded-[1.5rem] border border-[rgba(20,62,52,0.12)] bg-white/70 p-6 text-sm leading-6 text-stone-600">
          <p class="text-[10px] font-medium uppercase tracking-[0.28em] text-stone-500">memo</p>
          <ul class="mt-4 list-disc space-y-2 pl-5">
            <li>店主の背景やこだわり</li>
            <li>料理との相性やおすすめの楽しみ方</li>
            <li>立ち寄りを歓迎する雰囲気</li>
          </ul>
        </div>
      </div>
    </section>

    <section id="visit" class="mt-20 grid gap-6 md:grid-cols-2">
      <div class="rounded-[2rem] bg-[#143e34] p-8 text-stone-100 shadow-[0_20px_60px_rgba(20,62,52,0.2)]">
        <p class="text-[10px] font-medium uppercase tracking-[0.36em] text-stone-300">Visit</p>
        <h3 class="mt-3 text-3xl text-stone-50 md:text-4xl">Open for a quiet evening</h3>

        <dl class="mt-7 space-y-4 text-sm text-stone-200">
          <div class="flex justify-between gap-4 border-b border-stone-700 pb-3">
            <dt class="text-stone-300">Address</dt>
            <dd class="text-right">東京都〇〇区〇〇 〇-〇-〇</dd>
          </div>
          <div class="flex justify-between gap-4 border-b border-stone-700 pb-3">
            <dt class="text-stone-300">Hours</dt>
            <dd class="text-right">18:00 - 23:30（仮）</dd>
          </div>
          <div class="flex justify-between gap-4 border-b border-stone-700 pb-3">
            <dt class="text-stone-300">Closed</dt>
            <dd class="text-right">月曜（仮）</dd>
          </div>
          <div class="flex justify-between gap-4">
            <dt class="text-stone-300">Reservation</dt>
            <dd class="text-right">Instagram / 電話 / Web予約</dd>
          </div>
        </dl>
      </div>

      <div id="reserve" class="rounded-[2rem] border border-[rgba(31,27,24,0.12)] bg-white/70 p-8">
        <p class="text-[10px] font-medium uppercase tracking-[0.36em] text-stone-500">Reserve</p>
        <h3 class="mt-3 text-3xl text-stone-900 md:text-4xl">お問い合わせ前の確認</h3>
        <p class="mt-4 text-base leading-8 text-stone-600">
          予約方法やフォームの扱いは未確定です。ここは、後で本番運用の導線へ置き換える想定のボックスです。
        </p>
        <a
          href="#"
          class="mt-8 inline-flex rounded-full bg-stone-900 px-6 py-3 text-[10px] font-medium uppercase tracking-[0.2em] text-stone-100 transition hover:bg-stone-700"
        >
          Contact for booking
        </a>
      </div>
    </section>

    <footer class="mt-20 border-t border-[rgba(31,27,24,0.12)] py-8 text-sm text-stone-500">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <p>Wine Bar Name / 初期モック</p>
        <div class="flex gap-5 text-[10px] uppercase tracking-[0.2em]">
          <a href="#">Instagram</a>
          <a href="#">X</a>
          <a href="#">Map</a>
        </div>
      </div>
    </footer>
  </main>
</Layout>
